{
  "name": "@execution-closure/protocol",
  "version": "0.1.0",
  "description": "Offline types, RFC 8785 canonicalize, and CLI for Execution Closure proofs. Synthetic sandbox only \u2014 not a bank.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kparkpq/agentic-bank.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/kparkpq/agentic-bank/tree/main/packages/protocol",
  "bugs": {
    "url": "https://github.com/kparkpq/agentic-bank/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./schemas/ec-v0.schema.json": "./schemas/ec-v0.schema.json",
    "./testing": "./src/testing.ts"
  },
  "bin": {
    "execution-closure-verify": "./bin/execution-closure-verify.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin",
    "fixtures",
    "release-manifest.json",
    "schemas",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "verify": "node --import tsx bin/execution-closure-verify.mjs",
    "packed-test": "node scripts/packed-package-test.mjs"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "canonicalize": "4.0.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^5.8.2",
    "vitest": "4.1.11"
  }
}
